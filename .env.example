# Copy to .env and fill in. Read by docker compose.
#   cp .env.example .env

# --- database (required) --------------------------------------------------

# Password for the bundled Postgres. Any long random string:
#   openssl rand -base64 24
# Changing it after first boot does NOT change the existing database — the
# volume keeps the original password. Reset with `docker compose down -v`.
POSTGRES_PASSWORD=

# Password for meelu_app, the non-superuser role the api, agent server and
# embed worker connect as. The migrate service (as POSTGRES_USER) creates it
# and hands it the app's tables. Any long random string, different from above.
APP_DB_PASSWORD=

# Only if you point the app at a Postgres you already run. Left unset, compose
# builds the URL from POSTGRES_* and the bundled `postgres` service.
# DATABASE_URL=postgres://user:pass@host:5432/craftmate
# POSTGRES_USER=craftmate
# POSTGRES_DB=craftmate

# Host interface and port Postgres is published on, for a GUI client. Bound to
# loopback by default; 5434 rather than 5432, which a local install often holds.
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5434

# --- backend ---------------------------------------------------------------

# Only if you point the backend at a Postgres you already run. Left unset,
# compose builds both SQLAlchemy URLs for the bundled service: the app role
# from APP_DB_PASSWORD, the migration superuser from POSTGRES_*.
# API_DATABASE_URL=postgresql+psycopg://meelu_app:pass@host:5432/craftmate
# MIGRATE_DATABASE_URL=postgresql+psycopg://superuser:pass@host:5432/craftmate

# Host interface and port the backend is published on. Loopback by default:
# the Electron app on this machine reaches it here, a browser never does
# because the dashboard proxies /api to it inside the compose network.
# API_BIND=127.0.0.1
# API_PORT=8100

# Same for the agent server (MCP over HTTP at /mcp). The app's harness and
# any MCP client connect here with an x-api-key header.
# AGENT_BIND=127.0.0.1
# AGENT_PORT=8484

# Where the dashboard proxies /api. Inside compose this is the api service.
# MEELU_API_URL=http://api:8000

# The session cookie is Secure by default, so browsers only send it over HTTPS.
# Local compose serves the dashboard over plain http://localhost, so turn it off
# here. Never set this to false on a deployment.
SESSION_COOKIE_SECURE=false

# Origins the dashboard is served from. A cookie-authenticated POST, PUT, PATCH
# or DELETE from a browser must come from one of these (or from CORS_ORIGINS).
# APP_ORIGINS=["http://localhost:3000"]

# Serve /docs, /redoc and /openapi.json on the api and the agent server.
# API_DOCS_ENABLED=true

# --- dashboard -------------------------------------------------------

# Host interface and port for the published dashboard port. Loopback-only by
# default.
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_PORT=3000

# --- Unsplash image search (optional) -------------------------------------

# Powers the "search Unsplash" half of the image picker on content posts.
# Without it, uploading still works and the picker says search is unavailable.
# Create an app at https://unsplash.com/oauth/applications and copy its Access
# Key (the Secret Key is not needed — we only read).
#
# New apps are in demo mode: 50 searches/hour. Applying for production raises
# it. Meelu already does the two things their guidelines require for that
# approval — crediting the photographer with the UTM links, and pinging the
# download endpoint when a photo is chosen.
# UNSPLASH_ACCESS_KEY=

# --- Sign-in (Better Auth) -----------------------------------------------

# Better Auth runs inside the dashboard at /auth/*: email + password, with a
# 6-digit email code to confirm the address and to reset a password. After
# sign-in the dashboard trades a short-lived Better Auth JWT for the usual
# meelu_session cookie at POST /api/auth/session; the api checks the JWT
# against the dashboard's /auth/jwks and creates the Meelu user on first sign-in.
#
# Required. Any long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=
#
# The origin the dashboard is served from. It is the JWT issuer and audience
# the api checks too.
# BETTER_AUTH_URL=http://localhost:3000
#
# Better Auth keeps its accounts in their own database, never the app's.
# Compose creates `auth` in the bundled Postgres (the `auth-db` one-shot) and
# points the dashboard at it. Set this only to use a different one.
# AUTH_DATABASE_URL=postgres://user:pass@host:5432/auth
#
# Sends the verification and password-reset codes from noreply@meelu.tech.
# Without it a dev server (`npm run dev`) prints each code to its console;
# a production build cannot send codes at all.
# RESEND_API_KEY=

# --- Payments (Dodo Payments) --------------------------------------------

# Users buy credits through a Dodo hosted checkout. Create ONE product with
# pay-what-you-want pricing; the api passes the top-up amount per checkout.
# Point a webhook at https://<your-dashboard-origin>/api/v1/payments/webhooks/dodo
# subscribed to payment.succeeded, payment.failed and payment.cancelled.
# https://app.dodopayments.com → Developer → API Keys / Webhooks
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_SECRET=whsec_...
# DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com   # live: https://live.dodopayments.com
# DODO_PAYMENTS_CREDITS_PRODUCT_ID=pdt_...
# DODO_PAYMENTS_RETURN_URL=https://meelu.tech/payment-complete

# --- Shared data vendors (one server-side account, charged to user credits) --

# DataForSEO powers the search-data tools (keyword facts, SERP snapshots,
# rankings, Lighthouse, LLM mentions). https://app.dataforseo.com/api-access
# The API credentials base64-encoded as `login:password`:
#   printf '%s' 'login:password' | base64
# DATAFORSEO_AUTH=

# Apify powers the paid social-listening platforms.
# https://console.apify.com/settings/integrations
# APIFY_API_KEY=

# Composio connects each website to the user's own email, CMS and CRM
# accounts (the email, cms and crm desks). One project key, server-side only.
# https://platform.composio.dev -> project -> Settings -> API keys
# COMPOSIO_API_KEY=

# Optional keys for the free social-listening APIs. GitHub search without a
# token allows 10 requests a minute (30 with one); Stack Exchange without an
# app key allows about 300 requests a day per IP (10,000 with one).
# https://github.com/settings/tokens  https://stackapps.com/apps/oauth/register
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=

# OpenRouter serves every LLM call the api makes or relays: page
# classification, link screening, and the app's agent, social listening and
# page review through /api/v1/llm, charged to the user's credits at cost.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# What each website costs per day, and how often the api sweeps for websites
# whose day is up. A website whose workspace cannot cover the day is marked
# disabled until credits arrive.
# CREDITS_SITE_DAILY_USD=0.4
# CREDITS_BILLING_PERIOD_HOURS=24
# CREDITS_BILLING_SWEEP_SECONDS=900
# CREDITS_BILLING_SWEEP_DISABLED=

# Balance a workspace must hold before a paid vendor call is allowed.
# CREDITS_MINIMUM_BALANCE_USD=0.2
# Most paid vendor calls (LLM included) one workspace can run at once, per process.
# CREDITS_PARALLEL_CALLS_PER_USER=10
# Seconds a paid call waits for a free slot before it is refused with 429.
# CREDITS_SLOT_WAIT_SECONDS=60
# Largest max_tokens the LLM gateway forwards; bigger requests are lowered to it.
# LLM_MAX_OUTPUT_TOKENS=32000
# Largest LLM request body the gateway accepts, in MB.
# LLM_MAX_REQUEST_MB=20

# ── Search Console (app only) ─────────────────────────────────────────────────
# The OAuth client the Search Console connector authorises against. This is the
# DEPLOYMENT's client, not a user's credential and not a platform data key: it
# buys nothing and grants nothing on its own. Its whole job is to let a user
# connect their own Search Console without first creating a Google Cloud
# project, which is the step that made the old service-account setup a
# three-parter with the middle step in Google's UI.
#
# Google's installed-app model explicitly does not treat a Desktop-app client's
# secret as confidential — PKCE is what binds the exchange — which is why this
# can ship inside the app and why no backend is involved. The per-user thing,
# the refresh token this client obtains, never leaves the user's device and is
# never seen by any Meelu server.
#
# Create it in Google Cloud → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Application type "Desktop app", and enable
# the Search Console API on the same project. Check the scope tier while you
# are there: webmasters.readonly must appear under "Non-sensitive scopes" on
# the consent screen. If Google files it as sensitive instead, the project is
# capped at 100 users for its lifetime and refresh tokens die every 7 days
# until verification clears — worth knowing before you ship it.
# MEELU_GSC_CLIENT_ID=
# MEELU_GSC_CLIENT_SECRET=

# ── Google Analytics (app only) ───────────────────────────────────────────────
# The OAuth client the GA4 connector authorises against. Same deal as the
# Search Console client above: this is the DEPLOYMENT's client, not a user's
# credential, and it reads nothing on its own. It exists so a user can connect
# their own GA4 property without first standing up a Google Cloud project.
#
# It is a SECOND client rather than a reuse of the Search Console one, and
# deliberately so. analytics.readonly is a sensitive scope; webmasters.readonly
# is not. One client carrying both scopes drags Search Console into GA's
# verification regime — the unverified 100-user cap and refresh tokens that die
# every 7 days — so a GA review would break search-data syncs that have nothing
# to do with it. Two clients keep the two failure modes apart.
#
# Create it in Google Cloud → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Application type "Desktop app", and enable
# both the Google Analytics Admin API (it lists the properties the user can
# pick from) and the Google Analytics Data API (it runs the report) on the same
# project.
# MEELU_GA_CLIENT_ID=
# MEELU_GA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Crawling
# ---------------------------------------------------------------------------
# Every crawl runs in the app, on your own machine and IP, and each website is
# its own task. The task limits below are per crawl; MEELU_CRAWL_MAX_OUTBOUND
# is the ceiling across all of them at once, so crawling your own site and
# three competitors together still opens one bounded set of connections rather
# than four independent ones.
#
# MEELU_CRAWL_MAX_OUTBOUND=12
# MEELU_CRAWL_PER_ORIGIN=6
# MEELU_API_CONNECTIONS=8
#
# Pages fetched at once within one crawl. Your own site gets the first number,
# somebody else's site the second — a competitor is a guest visit, not a load
# test. Both are still gated by MEELU_CRAWL_MAX_OUTBOUND above.
# MEELU_CRAWL_CONCURRENCY=8
# MEELU_CRAWL_RIVAL_CONCURRENCY=3
#
# CPU threads each embedding or reranking model may use, in the api and the
# embed worker. Unset, it is 2, so an embedding backlog after a crawl cannot
# take every core on the host.
# MEELU_ONNX_THREADS=2
#
# Postgres connections the api container keeps. The sum across every
# container has to stay under the server's max_connections (100).
# DATABASE_POOL_MAX=20

