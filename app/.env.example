# Where the dashboard server runs — the window loads this URL, and the local
# workers (crawler, syncs, schedules) talk to its API.
MEELU_BASE_URL=http://localhost:3000

# Where the agent reaches the Meelu agent server (the `agent` compose service,
# api/src/agent, streamable HTTP). The harness authenticates to it with the signed-in
# account's workspace API key.
MEELU_AGENT_MCP_URL=http://127.0.0.1:8484/mcp/

# Optional fallback only. Normally the harness acts as whoever is signed in
# in the app window (it reuses the window's session and the account's own
# workspace API key). This env key is used only for headless runs — the
# smoke scripts — where no window session exists.
# MEELU_API_KEY=emcp_replace_me

# ---- Which model the harness uses (it runs HERE, on your device) ----

# Anthropic (the default). Leave ANTHROPIC_API_KEY unset to use your Claude
# Code login (~/.claude), or bring your own key:
# ANTHROPIC_API_KEY=sk-ant-...
# MEELU_AGENT_MODEL=claude-haiku-4-5-20251001   # default; claude-sonnet-5 for harder work

# …or OpenRouter, which speaks the Anthropic Messages API at
# https://openrouter.ai/api and carries models from every vendor. Name the
# model provider-first:
# OPENROUTER_API_KEY=sk-or-v1-...
# MEELU_OPENROUTER_MODEL=anthropic/claude-sonnet-5

# …or a local model. Point at any endpoint speaking the Anthropic Messages
# API — Ollama v0.12+ does at :11434, llama.cpp's llama-server does at :8080
# (start it with --jinja for tool calling) — and name the model:
# MEELU_LLM_BASE_URL=http://localhost:11434
# MEELU_LLM_MODEL=qwen3.5:35b-a3b        # llama-server ignores the name
# MEELU_LLM_API_KEY=ollama               # only if your endpoint checks it

# ---- Google connectors (OAuth runs on this device; tokens stay in the OS keychain) ----

# Search Console connector — a Desktop OAuth client from your Google Cloud
# project, with the Search Console API enabled. A Desktop client secret is
# non-confidential under Google's installed-app model; PKCE binds the exchange.
# MEELU_GSC_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# MEELU_GSC_CLIENT_SECRET=GOCSPX-...

# Google Analytics connector — may reuse the same Desktop client. The Cloud
# project needs the Analytics Admin API and Analytics Data API enabled.
# MEELU_GA_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# MEELU_GA_CLIENT_SECRET=GOCSPX-...

# ---- Background schedules (on by default; set to 0 to turn one off) ----

# Auto-crawl: re-crawls each site once its last crawl is older than the
# interval. The ticker polls; the first check runs shortly after boot.
# MEELU_AUTO_CRAWL=0
# MEELU_AUTO_CRAWL_EVERY_HOURS=24
# MEELU_AUTO_CRAWL_TICK_MS=1800000       # poll every 30 min
# MEELU_AUTO_CRAWL_FIRST_TICK_MS=120000  # first check 2 min after boot

# ---- Outbound HTTP limits (crawler + API clients) ----

# MEELU_CRAWL_MAX_OUTBOUND=12   # total in-flight crawl fetches
# MEELU_CRAWL_PER_ORIGIN=6      # in-flight fetches per host
# MEELU_API_CONNECTIONS=8       # connection pool to the dashboard API

# ---- Development and testing ----

# Take a screenshot of the window after load, save to this path, then quit.
# MEELU_SHOT=/tmp/meelu.png
# MEELU_SHOT_DELAY_MS=6000

# Boot, wait this long, then quit (what `npm run boot-test` uses).
# MEELU_AUTOEXIT_MS=12000

# Site id the agent-server smoke script runs against (`npm run agent-smoke`).
# MEELU_SMOKE_SITE=site_...
