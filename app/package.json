{
  "name": "meelu-app",
  "version": "0.1.0",
  "description": "Meelu desktop — the web dashboard in a window, plus the agent harness. One Next.js codebase renders web and app; the agent chrome self-gates on app mode, so the web stays a plain CRUD site.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "dev": "electron .",
    "harness-smoke": "node scripts/harness-smoke.mjs",
    "agent-smoke": "node scripts/agent-mcp-smoke.mjs",
    "boot-test": "MEELU_AUTOEXIT_MS=12000 electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@huggingface/transformers": "^4.2.0",
    "@meelu/ai-detect": "file:packages/ai-detect",
    "@meelu/readability": "file:packages/readability",
    "@meelu/similarity": "file:packages/similarity",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.0",
    "robots-parser": "^3.0.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "electron": "^43.2.0"
  },
  "overrides": {
    "onnxruntime-node": "1.21.1"
  }
}
