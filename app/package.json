{
  "name": "meelu-app",
  "version": "0.1.9",
  "description": "Meelu desktop — the web dashboard in a window, plus the agent harness. One Next.js codebase renders web and app; the agent chrome self-gates on app mode, so the web stays a plain CRUD site.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "productName": "Meelu",
  "main": "src/main/index.js",
  "scripts": {
    "test": "node --import ./test/agent/register-electron.mjs --test \"test/**/*.test.js\"",
    "dev": "electron .",
    "harness-smoke": "node scripts/harness-smoke.mjs",
    "agent-smoke": "node scripts/agent-mcp-smoke.mjs",
    "boot-test": "MEELU_AUTOEXIT_MS=12000 electron .",
    "dist:mac": "node scripts/dist.mjs prod mac",
    "dist:win": "node scripts/dist.mjs prod win",
    "dist:store": "node scripts/dist.mjs prod store",
    "dist:mac:test": "node scripts/dist.mjs test mac",
    "dist:win:test": "node scripts/dist.mjs test win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@huggingface/transformers": "^4.2.0",
    "@meelu/ai-detect": "file:packages/ai-detect",
    "@meelu/readability": "file:packages/readability",
    "@meelu/similarity": "file:packages/similarity",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.0",
    "robots-parser": "^3.0.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "onnxruntime-node": "1.21.1"
  },
  "build": {
    "appId": "tech.meelu.app",
    "productName": "Meelu",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**",
      "oauth-client.json",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "Meelu-mac-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Meelu-windows-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "appx": {
      "identityName": "ShubhamRandive.Meelu",
      "publisher": "CN=62EA4499-A8A4-4A51-BF17-4B19F01B3EF1",
      "publisherDisplayName": "Shubham Randive",
      "displayName": "Meelu",
      "applicationId": "Meelu",
      "backgroundColor": "#1F2D3D",
      "languages": [
        "en-US"
      ]
    }
  }
}
