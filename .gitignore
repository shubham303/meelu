# Real config with the auth secret — never commit. .env.example is the template.
.env
.env.*
!.env.example

# ---------- dependencies ----------
# Every package in the monorepo installs its own: app, dashboard.
# No trailing slash: the report scripts under .claude-artifacts/ share one
# install via a symlink named node_modules, and a directory-only rule would
# commit that symlink as a link into an ignored path — broken in a fresh clone.
node_modules

# ---------- build output ----------
dist/
# Next.js, in dashboard/.
.next/
out/
# Electron packaging, if app/ is ever built for distribution.
release/
*.tsbuildinfo

# ---------- api (Python + uv) ----------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---------- local caches and logs ----------
*.log
npm-debug.log*
.turbo/
coverage/

# ---------- scratch ----------
.DS_Store

# Dev-only annotation captures (app annotator, Cmd+Shift+A)
.annotations/
.claude/settings.local.json
.claude/*.lock
.claude/worktrees/

# Timestamped screen captures from dev sessions — scratch, not assets.
images/

# Pre-migration data dumps taken before a destructive migration.
.backups/

build/
app/oauth-client.json

temp.txt

# Local plans, research and backlog. Never pushed.
.claude-artifacts/

leads/
